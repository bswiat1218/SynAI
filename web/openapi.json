        ],
        "title": "ProjectListResponse",
        "type": "object"
      },
      "ProjectRegistrationRequest": {
        "additionalProperties": false,
        "properties": {
          "workspace_key": {
            "maxLength": 32,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_-]*$",
            "title": "Workspace Key",
            "type": "string"
          }
        },
        "required": [
          "workspace_key"
        ],
        "title": "ProjectRegistrationRequest",
        "type": "object"
      },
      "ProjectResponse": {
        "additionalProperties": false,
        "properties": {
          "access": {
            "default": "read_only",
            "title": "Access",
            "type": "string"
          },
          "id": {
            "maxLength": 32,
            "minLength": 32,
            "pattern": "^[a-f0-9]{32}$",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "status"
        ],
        "title": "ProjectResponse",
        "type": "object"
      },
      "SessionResponse": {
        "additionalProperties": false,
        "properties": {
          "authenticated": {
            "title": "Authenticated",
            "type": "boolean"
          },
          "expires_at": {
            "title": "Expires At",
            "type": "integer"
          }
        },
        "required": [
          "authenticated",
          "expires_at"
        ],
        "title": "SessionResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "CsrfToken": {
        "in": "header",
        "name": "X-CSRF-Token",
        "type": "apiKey"
      },
      "SessionCookie": {
        "in": "cookie",
        "name": "synai_session",
        "type": "apiKey"
      }
    }
