Screen {
    background: $background;
    color: $foreground;
}
Label, Static { color: $foreground; }
Header, Footer {
    background: $panel;
    color: $foreground;
}
#neon-banner {
    height: 2;
    padding: 0 1;
    background: $panel;
    color: $foreground;
    text-style: bold;
    border-bottom: double $secondary;
    content-align: center middle;
}
#body { height: 1fr; }
#conversation-summary {
    height: 2;
    padding: 0 1;
    background: $panel;
    color: $foreground;
    overflow: hidden hidden;
}
#main { width: 2fr; min-width: 30; padding: 0 1; }
#activity-panel { width: 1fr; min-width: 25; padding: 0 1; }
.pane-title {
    height: 1;
    color: $foreground;
    background: $panel;
    text-style: bold;
    padding: 0 1;
}
#activity-panel .pane-title { color: $foreground; background: $panel; }
RichLog {
    background: $surface;
    color: $foreground;
    border: solid $accent;
    scrollbar-color: $accent;
    scrollbar-background: $panel;
    padding: 0 1;
}
#chat { height: 1fr; border: double $primary; }
#thinking { height: 1fr; border: double $secondary; }
#activity { height: 2fr; border: double $accent; }
#composer { height: 7; border: solid $primary; background: $surface; color: $foreground; }
#composer:focus { border: double $primary; }
#buttons { height: 3; }
Button {
    height: 3;
    min-width: 10;
    background: $panel;
    color: $foreground;
    border: solid $accent;
    text-style: bold;
}
Button:hover { background: $surface; border: solid $secondary; }
Button:focus { border: double $primary; background-tint: transparent; }
Button.-success { background: $panel; color: $foreground; border: double $success; }
Button.-warning { background: $panel; color: $foreground; border: solid $warning; }
Button.-error { background: $panel; color: $foreground; border: solid $error; }
Button:disabled {
    opacity: 100%;
    text-opacity: 100%;
    color: $foreground;
    background: $surface;
    text-style: none;
    border: dashed $accent;
}
Button.-success:hover, Button.-warning:hover, Button.-error:hover {
    background: $surface;
    color: $foreground;
}
Button.-active, Button.-success.-active, Button.-warning.-active, Button.-error.-active {
    background: $surface;
    color: $foreground;
    tint: transparent;
}
Input, Select { background: $panel; color: $foreground; border: solid $accent; }
Input:disabled, Select:disabled, TextArea:disabled {
    opacity: 100%;
    text-opacity: 100%;
    color: $foreground;
    text-style: none;
    border: dashed $accent;
}
Input:focus, Select:focus { border: double $primary; }
SelectCurrent { background: $panel; color: $foreground; }
SelectOverlay { background: $panel; color: $foreground; border: double $secondary; }
#capability { height: auto; color: $foreground; }
#status { height: 1; background: $panel; color: $foreground; padding: 0 1; }
MenuScreen {
    align: center middle;
    background: $background 85%;
}
#directory-picker {
    width: 95%;
    max-width: 100;
    height: 90%;
    border: double $primary;
    background: $surface;
    padding: 0 1;
}
#directory-picker > Static { height: auto; max-height: 3; overflow-y: auto; }
DirectoryPicker.compact-menu #directory-picker { width: 100%; height: 100%; }
#directory-location { color: $foreground; }
#directory-list { height: 1fr; background: $surface; border: solid $accent; scrollbar-color: $accent; }
#directory-list:focus { border: double $primary; }
#directory-error { color: $foreground; text-style: bold; }
.menu-card {
    width: 75%;
    max-width: 90;
    height: auto;
    max-height: 95%;
    background: $surface;
    border: double $primary;
    padding: 1 2;
    scrollbar-color: $accent;
}
.modal-shell {
    width: 96%;
    max-width: 110;
    height: 90%;
    background: $surface;
    border: double $primary;
    padding: 0 1;
}
.modal-shell > .modal-title { margin: 0; height: 1; }
.modal-body { height: 1fr; padding: 0 1; scrollbar-color: $accent; }
.modal-body Label { height: auto; margin-top: 1; }
.modal-body Static { height: auto; margin-bottom: 1; }
.modal-body Button { width: 100%; }
.modal-actions { height: 3; }
.modal-actions Button { width: 1fr; min-width: 0; height: 100%; margin: 0; }
MenuScreen.compact-menu #history-actions { height: 4; }
#theme-list { height: 1fr; border: solid $accent; background: $surface; color: $foreground; }
#theme-list:focus { border: double $primary; }
#theme-list > .option-list--option-highlighted {
    background: $panel;
    color: $foreground;
    text-style: bold;
}
#theme-status { height: auto; max-height: 3; }
#theme-sample { height: 2; border-left: solid $secondary; padding-left: 1; }
#theme-error { height: auto; max-height: 3; overflow-y: auto; text-style: bold; }
.menu-hints { height: 1; color: $foreground; }
.modal-shell > Button { width: 100%; min-width: 0; }
MenuInput.editing, MenuInput.editing:focus {
    border: double $secondary;
    background: $panel;
    color: $foreground;
}
.menu-card Button { width: 100%; }
#menu-logo { height: 3; content-align: center middle; color: $foreground; text-style: bold; }
.menu-subtitle { color: $foreground; content-align: center middle; margin-bottom: 1; }
.menu-section { color: $foreground; text-style: bold; height: 1; margin-top: 1; }
#menu-status { height: auto; color: $foreground; margin-bottom: 1; }
#dashboard {
    width: 96%;
    max-width: 120;
    height: 95%;
    background: $surface;
    border: double $primary;
    padding: 0 1;
}
#dashboard .modal-title { margin: 0; }
#dashboard #menu-status { height: auto; max-height: 3; margin: 0; }
#dashboard-content { height: 1fr; scrollbar-color: $accent; }
#dashboard-columns { height: auto; }
.dashboard-column { width: 1fr; height: auto; }
.dashboard-group { height: auto; padding: 0 1; margin-bottom: 1; border-left: solid $accent; }
.dashboard-group .menu-section { margin: 0; }
.dashboard-group Button { width: 100%; min-width: 0; }
#menu-connection-status { height: auto; }
#dashboard-hints { height: 1; }
MainMenu.narrow #dashboard-columns { layout: vertical; }
MainMenu.narrow .dashboard-column { width: 100%; }
#conversation-message { height: auto; margin: 1 0; }
.environment-card {
    width: 95%;
    max-width: 120;
    height: 90%;
    background: $surface;
    border: double $secondary;
    padding: 0 1;
}
#configuration-body { height: 1fr; }
#configuration-nav {
    width: 18;
    height: 100%;
    border-right: double $accent;
    padding-right: 1;
    scrollbar-color: $accent;
}
.config-nav { width: 100%; min-width: 0; }
.config-nav.active-page { background: $panel; color: $foreground; border: solid $secondary; }
#configuration-pages { width: 1fr; height: 100%; }
.configuration-page { height: 100%; padding: 0 1; scrollbar-color: $accent; }
.configuration-page Label { color: $foreground; margin-top: 1; }
.configuration-title { background: $panel; text-style: bold; }
.configuration-page Static { height: auto; margin: 1 0; }
.configuration-page Button { width: 100%; }
#config-host-warning { color: $foreground; border: solid $warning; padding: 0 1; text-style: bold; }
#environment-result { height: auto; max-height: 5; overflow-y: auto; }
#configuration-draft-status { height: 1; }
EnvironmentMenu.narrow .environment-card { padding: 0 1; width: 100%; height: 95%; }
EnvironmentMenu.narrow #configuration-nav { width: 16; }
#approval {
    width: 96%;
    max-width: 110;
    height: 90%;
    background: $surface;
    border: double $warning;
    padding: 0 1;
}
#approval-title { color: $foreground; text-style: bold; height: auto; max-height: 3; }
#approval VerticalScroll { height: 1fr; }
#history-manager {
    width: 96%;
    max-width: 110;
    height: 90%;
    background: $surface;
    border: double $secondary;
    padding: 0 1;
}
.modal-title {
    background: $panel;
    color: $foreground;
    text-style: bold;
    height: 1;
    margin-bottom: 1;
}
#history-selection {
    height: 1fr;
    margin: 1 0;
    background: $surface;
    border: double $accent;
    color: $foreground;
    scrollbar-color: $accent;
}
#history-selection:focus { border: double $primary; }
#history-selection > .option-list--option-highlighted {
    background: $panel;
    color: $foreground;
}
#history-selection > .selection-list--button-selected { color: $foreground; }
#history-selection > .selection-list--button-selected-highlighted { color: $foreground; }
#history-result { height: auto; max-height: 6; overflow-y: auto; color: $foreground; }
Input:focus, RichLog:focus, Select:focus > SelectCurrent, Select > SelectOverlay:focus {
    background-tint: transparent;
}
Input > .input--placeholder, Input > .input--suggestion {
    color: $foreground;
    text-style: none;
}
Input > .input--cursor, #composer > .text-area--cursor {
    color: $foreground;
    background: $panel;
    text-style: bold underline;
}
Input > .input--selection, #composer > .text-area--selection {
    color: $foreground;
    background: $surface;
    text-style: bold underline;
}
SelectCurrent Static#label, SelectCurrent.-has-value Static#label, SelectCurrent .arrow {
    color: $foreground;
}
#composer > .text-area--placeholder, #composer > .text-area--suggestion,
#composer > .text-area--gutter, #composer > .text-area--cursor-gutter {
    color: $foreground;
    text-style: none;
}
#composer > .text-area--cursor-line, #composer > .text-area--cursor-gutter,
#composer > .text-area--matching-bracket {
    color: $foreground;
    background: $panel;
}
#composer > .text-area--matching-bracket { text-style: bold underline; }
#directory-list, #history-selection { color: $foreground; }
#directory-list > .option-list--option, #history-selection > .option-list--option,
SelectOverlay > .option-list--option,
#directory-list > .option-list--option-disabled, #history-selection > .option-list--option-disabled,
SelectOverlay > .option-list--option-disabled {
    color: $foreground;
    text-style: none;
}
#directory-list > .option-list--option-highlighted, #directory-list:focus > .option-list--option-highlighted,
#history-selection > .option-list--option-highlighted, #history-selection:focus > .option-list--option-highlighted,
SelectOverlay > .option-list--option-highlighted, SelectOverlay:focus > .option-list--option-highlighted {
    color: $foreground;
    background: $panel;
    text-style: bold;
}
#directory-list > .option-list--option-hover, #history-selection > .option-list--option-hover,
SelectOverlay > .option-list--option-hover {
    color: $foreground;
    background: $panel;
}
#directory-list:focus, #history-selection:focus { background-tint: transparent; }
#history-selection > .selection-list--button,
#history-selection > .selection-list--button-highlighted {
    color: $foreground;
    background: $panel;
}
#history-selection > .selection-list--button-selected,
#history-selection > .selection-list--button-selected-highlighted {
    color: #ff5555;
    background: $panel;
}
Footer FooterKey, Footer FooterKey:hover, Footer FooterLabel {
    color: $foreground;
    background: $panel;
}
Footer FooterKey.-disabled { text-style: none; }
Footer FooterKey > .footer-key--key, Footer FooterKey > .footer-key--description {
    color: $foreground;
    background: $panel;
}
Screen.narrow #body { layout: vertical; overflow-y: auto; }
Screen.narrow #neon-banner { height: 2; border: none; }
Screen.narrow #main { width: 100%; height: 1fr; min-height: 16; min-width: 0; }
Screen.narrow #activity-panel { width: 100%; height: 12; min-width: 0; }
Screen.compact #neon-banner { height: 2; border: none; }
Screen.compact #composer { height: 5; }
Screen.narrow.compact #activity-panel { height: 6; }
Screen.narrow.compact #main { min-height: 14; }
#connection-result { height: auto; max-height: 3; overflow-y: auto; }
#conversation-message { margin: 0; }
#directory-picker > .menu-hints { height: 1; max-height: 1; }
#directory-picker { height: 90%; max-width: 110; }
SandboxSwitch .modal-shell > Button { height: auto; min-height: 3; }

Button:focus, Button:focus:hover, Button:focus.-active,
Button.-success:focus, Button.-success:focus:hover, Button.-success:focus.-active,
Button.-warning:focus, Button.-warning:focus:hover, Button.-warning:focus.-active,
Button.-error:focus, Button.-error:focus:hover, Button.-error:focus.-active,
.config-nav.active-page:focus, .config-nav.active-page:focus:hover,
.config-nav.active-page:focus.-active {
    color: $foreground;
    background: $surface;
    border: double $primary;
    text-style: bold;
    background-tint: transparent;
    tint: transparent;
}
