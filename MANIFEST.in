include README.md LICENSE NOTICE pyproject.toml app.py
recursive-include synai *.py *.tcss *.lua *.Dockerfile
recursive-include tests *.py
recursive-include scripts *.py
recursive-include docs *.md
recursive-include .github/workflows *.yml
prune .venv
prune build
prune dist
prune results
prune prompts
global-exclude __pycache__ *.py[cod] *.log
